# Signs/verifies organizer session JWTs. Generate a long random string
# (e.g. `openssl rand -hex 32`) — do not reuse across environments.
JWT_SECRET=change-me

# Google Cloud OAuth 2.0 Client ID (Web application type) for "Sign in with
# Google". Create at https://console.cloud.google.com/apis/credentials —
# Authorized JavaScript origins must include your deployed origin and
# http://localhost:3000 for local dev. No redirect URI is needed since this
# uses Google Identity Services' ID-token flow, not classic OAuth redirect.
# The same value is needed both here (backend, audience verification) and as
# VITE_GOOGLE_CLIENT_ID (frontend build, inlined into the static bundle).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Resend (https://resend.com) API key for sending password-reset emails.
# Free tier is sufficient for this volume.
RESEND_API_KEY=

# "From" address for password-reset emails. Resend's shared sandbox sender
# onboarding@resend.dev works immediately with no domain verification —
# use it to get started; switch to a verified domain address later if desired.
RESEND_FROM=onboarding@resend.dev

# Base URL used to build the password-reset link emailed to organizers
# (e.g. https://your-app.onrender.com). Set explicitly in production.
PUBLIC_APP_URL=http://localhost:3000

# Where the SQLite database file lives. Defaults to ./data/rollmaster.db if unset.
DB_PATH=./data/rollmaster.db

# Port the Express server listens on. Defaults to 3001 in dev, set by the
# platform (e.g. Render) in production.
PORT=3001
